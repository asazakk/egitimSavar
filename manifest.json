{
  "manifest_version": 3,
  "name": "egitimSavar",
  "version": "1.7.2",
  "description": "Uzaktan Eğitim Kapısı eğitimlerini ayrı sekmelerde veya ekran pencerelerinde otomatik oynatır: hızlandırır, sesi kapatır, ilerletir ve takip raporu sunar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "egitimsavar@local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://uzaktanegitimkapisi.gov.tr/*",
    "https://*.uzaktanegitimkapisi.gov.tr/*",
    "https://vod2.uzaktanegitimkapisi.gov.tr/*",
    "https://vod3.uzaktanegitimkapisi.gov.tr/*",
    "https://uzaktanegitimkapisi.cbiko.gov.tr/*",
    "https://*.cbiko.gov.tr/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["report-core.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://uzaktanegitimkapisi.gov.tr/*",
        "https://*.uzaktanegitimkapisi.gov.tr/*",
        "https://vod2.uzaktanegitimkapisi.gov.tr/*",
        "https://vod3.uzaktanegitimkapisi.gov.tr/*",
        "https://uzaktanegitimkapisi.cbiko.gov.tr/*",
        "https://*.cbiko.gov.tr/*"
      ],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://uzaktanegitimkapisi.gov.tr/*",
        "https://*.uzaktanegitimkapisi.gov.tr/*",
        "https://vod2.uzaktanegitimkapisi.gov.tr/*",
        "https://vod3.uzaktanegitimkapisi.gov.tr/*",
        "https://uzaktanegitimkapisi.cbiko.gov.tr/*",
        "https://*.cbiko.gov.tr/*"
      ],
      "js": ["page-guard.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "egitimSavar",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup.html"
  }
}
